# Gemini (chat + vision) — required
GEMINI_API_KEY=

# ElevenLabs (voice) — required for the app to actually speak replies out loud.
# If this is missing or invalid, /api/voice will fail and no audio will play,
# even though text chat keeps working.
ELEVEN_LAB_API_KEY=

# MongoDB — required. Free tier: https://www.mongodb.com/cloud/atlas/register
# Local dev fallback also works: mongodb://localhost:27017
MONGODB_URI=
MONGODB_DB_NAME=character_ai

# JWT — required for signup/login. Set to any long random string, e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=43200

# Optional overrides
DEFAULT_VOICE_ID=kL9K8Oa7kpcfpt2kQBzY
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEMORY_MAX_RAW_MESSAGES=16

# Google Sign-In — required for the "Continue with Google" button.
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your frontend
# URL to "Authorized JavaScript origins". Must match VITE_GOOGLE_CLIENT_ID
# in frontend/.env exactly (same value, both sides).
GOOGLE_CLIENT_ID=

# Cloudinary — required for uploading profile / character avatar photos.
# Free tier: https://cloudinary.com/users/register/free — values are on
# your Cloudinary dashboard home page after signup.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gamification: quiz points ---
POINTS_PER_CORRECT_ANSWER=10

# --- Razorpay (platform-wide subscription) ---
# Test-mode keys from https://dashboard.razorpay.com/app/keys (start with
# rzp_test_). Without these set, the "Get Subscription" flow returns a clear
# 503 instead of failing silently — points-based unlocking still works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Amount in paise — 19900 = ₹199.00
SUBSCRIPTION_PRICE_PAISE=19900
SUBSCRIPTION_DURATION_DAYS=30
